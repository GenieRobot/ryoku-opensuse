[Unit]
Description=Ryoku per-user service

[Service]
Type=simple
ExecStart=/usr/libexec/ryoku/ryoku-service
UMask=0077
NoNewPrivileges=yes
# Preserve native root ownership for the fixed runtime-parent checks. A user
# manager needs a private user namespace to provide a private mount namespace.
PrivateTmp=no
PrivateUsers=no
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
