[Unit]
Description=Ryoku per-user service

[Service]
Type=simple
ExecStart=/usr/libexec/ryoku/ryoku-service
Environment=XDG_STATE_HOME=%h/.local/state
UMask=0077
NoNewPrivileges=yes
# Preserve root ownership checks: mount isolation in a user manager also
# remaps root through a user namespace.
PrivateTmp=no
PrivateUsers=no
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
