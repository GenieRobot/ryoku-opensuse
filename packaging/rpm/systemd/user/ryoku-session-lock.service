[Unit]
Description=Native Ryoku session lock
PartOf=ryoku-desktop-session.target
After=ryoku-desktop-session.target
# A lock request must fail its start job if the manager lost the session
# identities; a failed Condition would silently skip instead.
AssertEnvironment=WAYLAND_DISPLAY
AssertEnvironment=!WAYLAND_DISPLAY=
AssertEnvironment=HYPRLAND_INSTANCE_SIGNATURE
AssertEnvironment=!HYPRLAND_INSTANCE_SIGNATURE=

[Service]
Type=exec
ExecStart=/usr/bin/hyprlock --config /usr/share/ryoku-opensuse/session/hyprlock.conf
# The distribution-owned PAM stack may execute its native authentication
# helper. Start this from the ordinary user manager, not the NNP shell tree.
NoNewPrivileges=no
KillMode=control-group
TimeoutStopSec=15s
Slice=session.slice
