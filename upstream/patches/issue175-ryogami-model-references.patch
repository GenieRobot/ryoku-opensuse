+package main
+
+// The Rust provider owns exact media paths and recoverable moves. This private
+// actor only commits one reviewed catalog row after its linked permit; it never
+// accepts a public row, path, filesystem command or recovery assertion.
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"syscall"
+)
+
+const brokerCatalogLimit = 16 * 1024 * 1024
+
+type brokerCatalogMutation struct {
+	Action string          `json:"action"`
+	Key    string          `json:"key"`
+	Entry  json.RawMessage `json:"entry,omitempty"`
+}
+type brokerCatalogCommit struct {
+	ExpectedCatalog string                `json:"expected_catalog"`
+	StagingToken    string                `json:"staging_token"`
+	Mutation        brokerCatalogMutation `json:"mutation"`
+}
+
+func (c brokerCatalogCommit) valid() bool {
+	if !brokerModelDigest(c.ExpectedCatalog) || !brokerModelDigest(c.StagingToken) || len(c.Mutation.Key) == 0 || len(c.Mutation.Key) > 512 {
+		return false
+	}
+	for _, ch := range c.Mutation.Key {
+		if ch < 32 || ch == 127 {
+			return false
+		}
+	}
+	switch c.Mutation.Action {
+	case "remove":
+		return len(c.Mutation.Entry) == 0
+	case "insert":
+		var row Entry
+		return len(c.Mutation.Entry) <= 32768 && json.Unmarshal(c.Mutation.Entry, &row) == nil && row.Key == c.Mutation.Key && (row.Type == "static" || row.Type == "video")
+	default:
+		return false
+	}
+}
+func brokerCatalogRead(parent *os.File) (*os.File, []byte, *syscall.Stat_t, error) {
+	file, err := brokerModelOpen(parent, "index.json", false)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	st, err := brokerModelOwned(file, false)
+	if err != nil || st.Size < 0 || st.Size > brokerCatalogLimit {
+		file.Close()
+		return nil, nil, nil, errors.New("catalog capacity")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, brokerCatalogLimit+1))
+	after, afterErr := brokerModelOwned(file, false)
+	if err != nil || afterErr != nil || len(data) > brokerCatalogLimit || int64(len(data)) != st.Size || !brokerModelSameInode(st, after) {
+		file.Close()
+		return nil, nil, nil, errors.New("catalog changed")
+	}
+	return file, data, st, nil
+}
+func brokerPersistCatalog(root *os.File, commit brokerCatalogCommit, expected map[string]Entry) (map[string]Entry, Entry, error) {
+	fail := func() (map[string]Entry, Entry, error) {
+		return nil, Entry{}, errors.New("catalog transaction failed; use linked recovery")
+	}
+	if !commit.valid() {
+		return fail()
+	}
+	rootStat, err := brokerModelOwned(root, true)
+	if err != nil {
+		return fail()
+	}
+	parent := root
+	opened := []*os.File{}
+	defer func() {
+		for _, file := range opened {
+			file.Close()
+		}
+	}()
+	for _, component := range []string{".cache", "ryogami", "wallpaper"} {
+		next, err := brokerModelOpen(parent, component, true)
+		if err != nil {
+			return fail()
+		}
+		opened = append(opened, next)
+		st, err := brokerModelOwned(next, true)
+		if err != nil || st.Dev != rootStat.Dev {
+			return fail()
+		}
+		parent = next
+	}
+	source, original, st, err := brokerCatalogRead(parent)
+	if err != nil {
+		return fail()
+	}
+	defer source.Close()
+	if st.Dev != rootStat.Dev || fmt.Sprintf("%x", sha256.Sum256(original)) != commit.ExpectedCatalog {
+		return fail()
+	}
+	var rows map[string]json.RawMessage
+	var before map[string]Entry
+	if json.Unmarshal(original, &rows) != nil || rows == nil || json.Unmarshal(resolvedJSON(original), &before) != nil || !reflect.DeepEqual(before, expected) {
+		return fail()
+	}
+	var event Entry
+	if commit.Mutation.Action == "remove" {
+		var exists bool
+		event, exists = before[commit.Mutation.Key]
+		if !exists || event.Key != commit.Mutation.Key || (event.Type != "static" && event.Type != "video") {
+			return fail()
+		}
+		delete(rows, commit.Mutation.Key)
+	} else {
+		if _, exists := rows[commit.Mutation.Key]; exists {
+			return fail()
+		}
+		rows[commit.Mutation.Key] = commit.Mutation.Entry
+		if json.Unmarshal(resolvedJSON(commit.Mutation.Entry), &event) != nil {
+			return fail()
+		}
+	}
+	data, err := json.Marshal(rows)
+	if err != nil || len(data) > brokerCatalogLimit {
+		return fail()
+	}
+	name := ".ryoku-catalog-" + commit.StagingToken + ".part"
+	fd, err := syscall.Openat(int(root.Fd()), name, syscall.O_CREAT|syscall.O_EXCL|syscall.O_RDWR|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0600)
+	if err != nil {
+		return fail()
+	}
+	stage := os.NewFile(uintptr(fd), "catalog stage")
+	defer stage.Close()
+	if _, err = stage.Write(data); err != nil {
+		return fail()
+	}
+	if stage.Chmod(os.FileMode(st.Mode&0777)) != nil || brokerModelAttributes(source, stage) != nil || stage.Sync() != nil || root.Sync() != nil {
+		return fail()
+	}
+	current, check, after, err := brokerCatalogRead(parent)
+	if err != nil {
+		return fail()
+	}
+	current.Close()
+	if !brokerModelSameInode(st, after) || !bytes.Equal(original, check) {
+		return fail()
+	}
+	if syscall.Renameat(int(root.Fd()), name, int(parent.Fd()), "index.json") != nil || parent.Sync() != nil || root.Sync() != nil {
+		return fail()
+	}
+	current, check, _, err = brokerCatalogRead(parent)
+	if err != nil {
+		return fail()
+	}
+	current.Close()
+	if !bytes.Equal(check, data) {
+		return fail()
+	}
+	var entries map[string]Entry
+	if json.Unmarshal(resolvedJSON(data), &entries) != nil {
+		return fail()
+	}
+	return entries, event, nil
+}
+func (d *daemon) brokerCatalogApply(commit brokerCatalogCommit) (interface{}, error) {
+	if d.store == nil || filepath.Clean(d.store.dir) != filepath.Join(home(), ".cache", "ryogami", "wallpaper") {
+		return nil, errors.New("catalog account binding changed")
+	}
+	d.store.mu.Lock()
+	root, err := os.Open(home())
+	if err != nil {
+		d.store.mu.Unlock()
+		return nil, errors.New("catalog account unavailable")
+	}
+	entries, event, err := brokerPersistCatalog(root, commit, d.store.entries)
+	root.Close()
+	if err == nil {
+		d.store.entries = entries
+	}
+	d.store.mu.Unlock()
+	if err != nil {
+		return nil, err
+	}
+	if commit.Mutation.Action == "remove" {
+		d.broadcast("ryogami.wall.file_removed", map[string]interface{}{"key": event.Key, "name": event.Name, "type": event.Type})
+	} else {
+		d.broadcast("ryogami.wall.cached", event)
+	}
+	return map[string]interface{}{"committed": true, "key": commit.Mutation.Key, "action": commit.Mutation.Action}, nil
+}
