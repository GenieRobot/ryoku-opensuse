+	original := []byte(`{"fixture":{"key":"fixture","name":"sample.png","type":"static","path":"~/Pictures/sample.png","future":9007199254740993},"private":{"key":"private","name":"private.png","type":"static","future":9007199254740995}}`)
+	if err := os.WriteFile(filepath.Join(path, ".cache/ryogami/wallpaper/index.json"), original, 0640); err != nil {
