+func TestBrokerModelsPreservesPosixACLAndRetainsFailedStageForRecovery(t *testing.T) {
+	root, path, original, commit := modelFixture(t)
+	target := filepath.Join(path, ".config/ryoku/ryogami.json")
+	acl := make([]byte, 4+5*8)
+	binary.LittleEndian.PutUint32(acl, 2)
+	entries := [][3]uint32{{1, 6, 0xffffffff}, {2, 4, uint32(os.Geteuid() + 1)}, {4, 4, 0xffffffff}, {16, 4, 0xffffffff}, {32, 0, 0xffffffff}}
+	for i, entry := range entries {
