+func TestBrokerModelsStaleSelectionDigestAndStageCollisionRefuseBeforeTargetWrite(t *testing.T) {
+	for _, kind := range []string{"selection", "digest", "collision", "missing", "link", "hardlink", "oversized"} {
+		t.Run(kind, func(t *testing.T) {
+			root, path, original, commit := modelFixture(t)
+			target := filepath.Join(path, ".config/ryoku/ryogami.json")
+			switch kind {
+			case "selection":
+				commit.ExpectedSelected = "/models/other/manifest.json"
+			case "digest":
+				bad := strings.Repeat("b", 64)
+				commit.ExpectedConfig = &bad
+			case "collision":
+				os.WriteFile(filepath.Join(path, ".ryoku-model-"+commit.StagingToken+".part"), []byte("recovery-stage"), 0600)
+			case "missing":
+				commit.ExpectedConfig = nil
+			case "link":
+				os.Rename(target, filepath.Join(path, "private-target"))
+				os.Symlink(filepath.Join(path, "private-target"), target)
+			case "hardlink":
+				os.Link(target, filepath.Join(path, "private-target"))
+			case "oversized":
+				original = []byte(strings.Repeat("x", brokerModelSettingsLimit+1))
+				os.WriteFile(target, original, 0640)
+			}
+			if _, err := brokerPersistModelReferences(root, commit); err == nil {
+				t.Fatal("unsafe commit accepted")
+			}
+			after, err := os.ReadFile(target)
+			if err != nil || string(after) != string(original) {
+				t.Fatal("refusal changed target")
+			}
+		})
+	}
+}
