+package main
+
+// Model list commits are prepared by the Rust provider and arrive only through
+// its one-use, linked-checkpoint actor permit. No general settings map, path or
+// command is accepted here. Selection-changing callbacks use a separate
+// transaction owned by the automatic-effects integration.
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+	"syscall"
+)
+
+const brokerModelSettingsLimit = 4 * 1024 * 1024
+
+type brokerModelReference struct {
+	Name       string  `json:"name"`
+	Manifest   string  `json:"manifest"`
+	Managed    bool    `json:"managed,omitempty"`
+	ID         *string `json:"id,omitempty"`
+	Version    *string `json:"version,omitempty"`
+	Dimensions *uint32 `json:"dimensions,omitempty"`
+	Bytes      *uint64 `json:"bytes,omitempty"`
+}
+type brokerModelReferences struct {
+	ExpectedConfig   *string                `json:"expected_config"`
+	StagingToken     string                 `json:"staging_token"`
+	Models           []brokerModelReference `json:"models"`
+	ExpectedSelected string                 `json:"expected_selected"`
+}
+
+func brokerModelDigest(value string) bool {
+	if len(value) != 64 {
+		return false
+	}
+	for _, c := range value {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
+func (c brokerModelReferences) valid() bool {
+	if c.ExpectedConfig != nil && !brokerModelDigest(*c.ExpectedConfig) || !brokerModelDigest(c.StagingToken) || c.Models == nil || len(c.Models) > 256 {
+		return false
+	}
+	if len(c.ExpectedSelected) > 4096 {
+		return false
+	}
+	for _, model := range c.Models {
+		if len(model.Name) > 256 || len(model.Manifest) > 4096 || model.Managed && model.ID == nil {
+			return false
+		}
+	}
+	return true
+}
+func brokerModelOwned(file *os.File, directory bool) (*syscall.Stat_t, error) {
+	var st syscall.Stat_t
+	if err := syscall.Fstat(int(file.Fd()), &st); err != nil {
+		return nil, err
+	}
+	kind := uint32(syscall.S_IFREG)
+	if directory {
+		kind = syscall.S_IFDIR
+	}
+	if st.Mode&syscall.S_IFMT != kind || st.Uid != uint32(os.Geteuid()) || st.Gid != uint32(os.Getegid()) || st.Mode&07022 != 0 || !directory && st.Nlink != 1 {
+		return nil, errors.New("unsafe model settings inode")
+	}
+	return &st, nil
+}
+func brokerModelOpen(parent *os.File, name string, directory bool) (*os.File, error) {
+	flags := syscall.O_RDONLY | syscall.O_NOFOLLOW | syscall.O_CLOEXEC | syscall.O_NONBLOCK
+	if directory {
+		flags |= syscall.O_DIRECTORY
+	}
+	fd, err := syscall.Openat(int(parent.Fd()), name, flags, 0)
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), "model settings")
+	if _, err := brokerModelOwned(file, directory); err != nil {
+		file.Close()
+		return nil, err
+	}
+	return file, nil
+}
+func brokerModelSameInode(a, b *syscall.Stat_t) bool {
+	return a.Dev == b.Dev && a.Ino == b.Ino && a.Mode == b.Mode && a.Nlink == b.Nlink && a.Uid == b.Uid && a.Gid == b.Gid && a.Size == b.Size && a.Mtim == b.Mtim && a.Ctim == b.Ctim
+}
+func brokerModelRead(parent *os.File) (*os.File, []byte, *syscall.Stat_t, error) {
+	file, err := brokerModelOpen(parent, "ryogami.json", false)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	st, err := brokerModelOwned(file, false)
+	if err != nil || st.Size < 0 || st.Size > brokerModelSettingsLimit {
+		file.Close()
+		return nil, nil, nil, errors.New("model settings capacity")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, brokerModelSettingsLimit+1))
+	after, afterErr := brokerModelOwned(file, false)
+	if err != nil || afterErr != nil || len(data) > brokerModelSettingsLimit || int64(len(data)) != st.Size || !brokerModelSameInode(st, after) {
+		file.Close()
+		return nil, nil, nil, errors.New("model settings changed")
+	}
+	return file, data, st, nil
+}
+func brokerModelAttributes(source, destination *os.File) error {
+	// /proc/self/fd pins the opened regular inode; no supplied pathname is used.
+	from := fmt.Sprintf("/proc/self/fd/%d", source.Fd())
+	to := fmt.Sprintf("/proc/self/fd/%d", destination.Fd())
+	names := make([]byte, 65536)
+	count, err := syscall.Listxattr(from, names)
+	if err != nil {
+		return err
+	}
+	values := map[string][]byte{}
+	for _, name := range strings.Split(string(names[:count]), "\x00") {
+		if name == "" {
+			continue
+		}
+		if name != "system.posix_acl_access" && name != "security.selinux" {
+			return errors.New("unenrolled model settings metadata")
+		}
+		value := make([]byte, 65536)
+		size, err := syscall.Getxattr(from, name, value)
+		if err != nil {
+			return err
+		}
+		values[name] = value[:size]
+	}
+	for _, name := range []string{"system.posix_acl_access", "security.selinux"} {
+		value, present := values[name]
+		current := make([]byte, 65536)
+		n, err := syscall.Getxattr(to, name, current)
+		if err != nil && err != syscall.ENODATA {
+			return err
+		}
+		if present {
+			if err != nil || !bytes.Equal(current[:n], value) {
+				if err := syscall.Setxattr(to, name, value, 0); err != nil {
+					return err
+				}
+			}
+		} else if err == nil {
+			if err := syscall.Removexattr(to, name); err != nil {
+				return err
+			}
+		}
+		n, err = syscall.Getxattr(to, name, current)
+		if present && (err != nil || !bytes.Equal(current[:n], value)) || !present && err != syscall.ENODATA {
+			return errors.New("model settings metadata readback changed")
+		}
+	}
+	return nil
+}
+
+// A failure leaves its exact enrolled stage for the Rust journal/recovery path.
+// The original target remains intact until the final same-device rename.
+func brokerPersistModelReferences(root *os.File, commit brokerModelReferences) (map[string]interface{}, error) {
+	if !commit.valid() || commit.ExpectedConfig == nil {
+		return nil, errors.New("model settings must already exist")
+	}
+	if _, err := brokerModelOwned(root, true); err != nil {
+		return nil, err
+	}
+	config, err := brokerModelOpen(root, ".config", true)
+	if err != nil {
+		return nil, err
+	}
+	defer config.Close()
+	parent, err := brokerModelOpen(config, "ryoku", true)
+	if err != nil {
+		return nil, err
+	}
+	defer parent.Close()
+	source, original, st, err := brokerModelRead(parent)
+	if err != nil {
+		return nil, err
+	}
+	defer source.Close()
+	parentStat, err := brokerModelOwned(parent, true)
+	if err != nil {
+		return nil, err
+	}
+	rootStat, err := brokerModelOwned(root, true)
+	if err != nil {
+		return nil, err
+	}
+	if st.Dev != rootStat.Dev || parentStat.Dev != rootStat.Dev || fmt.Sprintf("%x", sha256.Sum256(original)) != *commit.ExpectedConfig {
+		return nil, errors.New("model settings changed")
+	}
+	var tree map[string]interface{}
+	decoder := json.NewDecoder(bytes.NewReader(original))
+	decoder.UseNumber()
+	if decoder.Decode(&tree) != nil || tree == nil {
+		return nil, errors.New("invalid model settings")
+	}
+	if decoder.Decode(new(interface{})) != io.EOF {
+		return nil, errors.New("invalid model settings suffix")
+	}
+	semantic, ok := tree["semantic"].(map[string]interface{})
+	if !ok {
+		if tree["semantic"] != nil {
+			return nil, errors.New("invalid semantic settings")
+		}
+		semantic = map[string]interface{}{}
+		tree["semantic"] = semantic
+	}
+	selected := ""
+	if semantic["manifest"] != nil {
+		var ok bool
+		selected, ok = semantic["manifest"].(string)
+		if !ok {
+			return nil, errors.New("invalid model selection")
+		}
+	}
+	if selected != commit.ExpectedSelected {
+		return nil, errors.New("model selection changed")
+	}
+	// No semantic.manifest or semantic.enabled modification is permitted.
+	semantic["models"] = commit.Models
+	data, err := json.MarshalIndent(tree, "", "  ")
+	if err != nil || len(data) > brokerModelSettingsLimit {
+		return nil, errors.New("model settings capacity")
+	}
+	name := ".ryoku-model-" + commit.StagingToken + ".part"
+	fd, err := syscall.Openat(int(root.Fd()), name, syscall.O_CREAT|syscall.O_EXCL|syscall.O_RDWR|syscall.O_NOFOLLOW|syscall.O_CLOEXEC, 0600)
+	if err != nil {
+		return nil, errors.New("model settings stage unavailable")
+	}
+	stage := os.NewFile(uintptr(fd), "model settings stage")
+	defer stage.Close()
+	if _, err := stage.Write(data); err != nil {
+		return nil, err
+	}
+	if err := stage.Chmod(os.FileMode(st.Mode & 0777)); err != nil {
+		return nil, err
+	}
+	if err := brokerModelAttributes(source, stage); err != nil {
+		return nil, err
+	}
+	if err := stage.Sync(); err != nil {
+		return nil, err
+	}
+	if err := root.Sync(); err != nil {
+		return nil, err
+	}
+	current, check, after, err := brokerModelRead(parent)
+	if err != nil {
+		return nil, err
+	}
+	current.Close()
+	if !brokerModelSameInode(st, after) || !bytes.Equal(original, check) {
+		return nil, errors.New("model settings changed before publication")
+	}
+	if err := syscall.Renameat(int(root.Fd()), name, int(parent.Fd()), "ryogami.json"); err != nil {
+		return nil, err
+	}
+	if err := parent.Sync(); err != nil {
+		return nil, err
+	}
+	if err := root.Sync(); err != nil {
+		return nil, err
+	}
+	checkFile, check, _, err := brokerModelRead(parent)
+	if err != nil {
+		return nil, err
+	}
+	checkFile.Close()
+	if !bytes.Equal(data, check) {
+		return nil, errors.New("model settings readback changed")
+	}
+	return tree, nil
+}
+func (d *daemon) brokerModelReferencesApply(commit brokerModelReferences) (interface{}, error) {
+	settingsMu.Lock()
+	if len(settingsPending) != 0 {
+		settingsMu.Unlock()
+		return nil, errors.New("pending settings must finish before model transaction")
+	}
+	root, err := os.Open(home())
+	if err != nil {
+		settingsMu.Unlock()
+		return nil, err
+	}
+	tree, err := brokerPersistModelReferences(root, commit)
+	root.Close()
+	settingsMu.Unlock()
+	if err != nil {
+		return nil, errors.New("model reference transaction failed; use linked recovery")
+	}
+	setSettingsBaseline(flattenSettings(tree))
+	d.reloadConfig()
+	// Retain the upstream setting event then callback order after synchronous
+	// durable persistence. No selected-model callback is suppressed or forged.
+	models := make([]interface{}, len(commit.Models))
+	for i, model := range commit.Models {
+		b, _ := json.Marshal(model)
+		_ = json.Unmarshal(b, &models[i])
+	}
+	d.broadcast("ryogami.settings.changed", map[string]interface{}{"values": map[string]interface{}{"semantic.models": models}})
+	d.notifySetting("semantic.models", models)
+	return map[string]interface{}{"committed": true, "models": len(models)}, nil
+}
