+func (d *daemon) sourceMetadata(call brokerMetadataCall) brokerMetadataResponse {
+	response := brokerMetadataResponse{ID: call.RPCID, RequestID: call.RequestID}
+	fail := func(code string) brokerMetadataResponse { response.Error = code; return response }
+	params, valid := call.Query.Query.params()
+	if !valid || call.RPCID < 0 || !brokerMetadataID(call.RequestID) || !d.brokerLayoutMatches(call.HomeSHA) {
+		return fail("configuration")
+	}
+	settingsMu.Lock()
+	pending := len(settingsPending) != 0
+	settingsMu.Unlock()
+	if pending {
+		return fail("configuration")
+	}
+	root, err := os.Open(home())
+	if err != nil {
+		return fail("configuration")
+	}
+	defer root.Close()
+	data, err := brokerMetadataSettings(root)
+	if err != nil || (data == nil) != (call.Query.ExpectedSettings == nil) {
+		return fail("configuration")
+	}
+	if data != nil && (!brokerModelDigest(*call.Query.ExpectedSettings) || fmt.Sprintf("%x", sha256.Sum256(data)) != *call.Query.ExpectedSettings) {
+		return fail("configuration")
+	}
+	tree := map[string]interface{}{}
+	if data != nil && (json.Unmarshal(data, &tree) != nil || tree == nil) {
+		return fail("configuration")
+	}
+	// Every source setting and credential is read from this immutable snapshot,
+	// without pending/global settings or callbacks changing a running request.
+	source := newMetadataSources(d, tree)
+	available, reason := source.providerAvailability(call.Query.Query.Source)
+	if !available {
+		if reason == "MissingCredentials" {
+			return fail("missing_credentials")
+		}
+		return fail("disabled")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), searchFetchTimeout)
+	defer cancel()
+	page, err := source.runSearch(ctx, call.Query.Query.Source, params)
+	if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		return fail("timeout")
+	}
+	if err != nil {
+		return fail("provider_unavailable")
+	}
+	if len(page.results) > 256 || page.currentPage < 1 || page.lastPage < 0 || len(page.nextCursor) > 4096 {
+		return fail("invalid_response")
+	}
+	result := &brokerMetadataPage{Results: make([]brokerMetadataItem, 0, len(page.results)), LastPage: page.lastPage, CurrentPage: page.currentPage, NextCursor: page.nextCursor}
+	for _, item := range page.results {
+		result.Results = append(result.Results, brokerMetadataItem{ID: item.id, FullURL: item.fullURL, ThumbURL: item.thumbURL, Resolution: item.resolution, FileSize: item.fileSize, Title: item.title, TrackURL: item.trackURL, Attribution: item.attribution, AttributionURL: item.attributionURL, DurationSecs: item.durationSecs, Purity: item.purity, Category: item.category})
+	}
+	encoded, err := json.Marshal(result)
+	if err != nil || len(encoded) > 256*1024 {
+		return fail("invalid_response")
+	}
+	response.Result = result
+	return response
+}
+
+func (d *daemon) brokerSourceMetadata(conn net.Conn) {
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(30 * time.Second))
+	reader := bufio.NewReader(io.LimitReader(conn, 65537))
+	line, err := reader.ReadBytes('\n')
+	if err != nil || len(line) > 65536 {
+		return
+	}
+	if _, err = reader.ReadByte(); err != io.EOF {
+		return
+	}
+	var call brokerMetadataCall
+	decoder := json.NewDecoder(bytes.NewReader(line))
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&call) != nil || decoder.Decode(new(interface{})) != io.EOF || call.Actor.PID != os.Getpid() {
+		return
+	}
+	stat, err := os.ReadFile("/proc/self/stat")
+	if err != nil {
+		return
+	}
+	end := strings.LastIndex(string(stat), ") ")
+	if end < 0 {
+		return
+	}
+	fields := strings.Fields(string(stat)[end+2:])
+	if len(fields) < 20 {
+		return
+	}
+	start, err := strconv.ParseUint(fields[19], 10, 64)
+	if err != nil || start != call.Actor.Start {
+		return
+	}
+	response := d.sourceMetadata(call)
+	_ = json.NewEncoder(conn).Encode(response)
+}
