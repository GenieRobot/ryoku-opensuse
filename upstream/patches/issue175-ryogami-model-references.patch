+func modelFixture(t *testing.T) (*os.File, string, []byte, brokerModelReferences) {
+	t.Helper()
+	path := t.TempDir()
+	if err := os.Chmod(path, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(path, ".config/ryoku"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	original := []byte(`{"secret":"fixture-only-private","large":9007199254740993,"semantic":{"enabled":true,"manifest":"/models/a/manifest.json","models":[{"name":"A","manifest":"/models/a/manifest.json"}]}}`)
+	if err := os.WriteFile(filepath.Join(path, ".config/ryoku/ryogami.json"), original, 0640); err != nil {
+		t.Fatal(err)
+	}
+	root, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { root.Close() })
+	hash := fmt.Sprintf("%x", sha256.Sum256(original))
+	commit := brokerModelReferences{ExpectedConfig: &hash, StagingToken: strings.Repeat("a", 64), ExpectedSelected: "/models/a/manifest.json", Models: []brokerModelReference{{Name: "A", Manifest: "/models/a/manifest.json"}, {Name: "B", Manifest: "/models/b/manifest.json"}}}
+	return root, path, original, commit
+}
+func TestBrokerModelsDurableWritePreservesSecretsNumbersModeSelectionAndUnrelatedFiles(t *testing.T) {
+	root, path, _, commit := modelFixture(t)
+	sentinel := filepath.Join(path, "unrelated-secret")
+	if err := os.WriteFile(sentinel, []byte("do-not-read-or-write"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	tree, err := brokerPersistModelReferences(root, commit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if tree["large"].(json.Number).String() != "9007199254740993" || tree["secret"] != "fixture-only-private" {
+		t.Fatal("unrelated settings changed")
+	}
+	data, err := os.ReadFile(filepath.Join(path, ".config/ryoku/ryogami.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var actual map[string]interface{}
+	if err := json.Unmarshal(data, &actual); err != nil {
+		t.Fatal(err)
+	}
+	semantic := actual["semantic"].(map[string]interface{})
+	if semantic["manifest"] != commit.ExpectedSelected || semantic["enabled"] != true || len(semantic["models"].([]interface{})) != 2 {
+		t.Fatal("wrong model result")
+	}
+	info, _ := os.Stat(filepath.Join(path, ".config/ryoku/ryogami.json"))
+	if info.Mode().Perm() != 0640 {
+		t.Fatal("mode lost")
+	}
+	if _, err := os.Stat(filepath.Join(path, ".ryoku-model-"+commit.StagingToken+".part")); !os.IsNotExist(err) {
+		t.Fatal("published stage remained")
+	}
+	secret, _ := os.ReadFile(sentinel)
+	if string(secret) != "do-not-read-or-write" {
+		t.Fatal("unrelated file changed")
+	}
+	if _, err := brokerPersistModelReferences(root, commit); err == nil {
+		t.Fatal("stale commit repeated")
+	}
+}
+func TestBrokerModelsStaleSelectionDigestAndStageCollisionRefuseBeforeTargetWrite(t *testing.T) {
+	for _, kind := range []string{"selection", "digest", "collision", "missing", "link", "hardlink", "oversized"} {
+		t.Run(kind, func(t *testing.T) {
+			root, path, original, commit := modelFixture(t)
+			target := filepath.Join(path, ".config/ryoku/ryogami.json")
+			switch kind {
+			case "selection":
+				commit.ExpectedSelected = "/models/other/manifest.json"
+			case "digest":
+				bad := strings.Repeat("b", 64)
+				commit.ExpectedConfig = &bad
+			case "collision":
+				os.WriteFile(filepath.Join(path, ".ryoku-model-"+commit.StagingToken+".part"), []byte("recovery-stage"), 0600)
+			case "missing":
+				commit.ExpectedConfig = nil
+			case "link":
+				os.Rename(target, filepath.Join(path, "private-target"))
+				os.Symlink(filepath.Join(path, "private-target"), target)
+			case "hardlink":
+				os.Link(target, filepath.Join(path, "private-target"))
+			case "oversized":
+				original = []byte(strings.Repeat("x", brokerModelSettingsLimit+1))
+				os.WriteFile(target, original, 0640)
+			}
+			if _, err := brokerPersistModelReferences(root, commit); err == nil {
+				t.Fatal("unsafe commit accepted")
+			}
+			after, err := os.ReadFile(target)
+			if err != nil || string(after) != string(original) {
+				t.Fatal("refusal changed target")
+			}
+		})
+	}
+}
