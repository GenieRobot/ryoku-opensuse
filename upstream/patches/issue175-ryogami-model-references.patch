+func TestBrokerModelsCallbacksObservePersistedListAfterEventAndNeverSelectionMutation(t *testing.T) {
+	_, path, _, commit := modelFixture(t)
+	t.Setenv("HOME", path)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(path, ".config"))
+	resetSettingsState()
+	t.Cleanup(resetSettingsState)
+	d := &daemon{events: newEventHub()}
+	event := d.events.subscribe()
+	defer d.events.unsubscribe(event)
+	previous := settingWatchers
+	t.Cleanup(func() { settingWatchers = previous })
+	calls := []string{}
+	settingWatchers = []settingWatcher{{prefix: "semantic.", fn: func(_ *daemon, key string, value interface{}) {
+		calls = append(calls, key)
+		select {
+		case line := <-event:
+			if !strings.Contains(line, "semantic.models") {
+				t.Fatal("incorrect preceding event")
+			}
+		default:
+			t.Fatal("callback ran before event")
+		}
+		actual := readJSONFile(t, filepath.Join(path, ".config/ryoku/ryogami.json"))
+		if len(actual["semantic"].(map[string]interface{})["models"].([]interface{})) != 2 {
+			t.Fatal("callback ran before durable file replacement")
+		}
+	}}}
+	result, err := d.brokerModelReferencesApply(commit)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.(map[string]interface{})["committed"] != true || len(calls) != 1 || calls[0] != "semantic.models" {
+		t.Fatal("wrong callback or result")
+	}
+	if len(settingsPending) != 0 {
+		t.Fatal("model write was deferred past reply")
+	}
+}
