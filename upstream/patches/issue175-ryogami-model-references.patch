+	if semantic["manifest"] != commit.ExpectedSelected || semantic["enabled"] != true || len(semantic["models"].([]interface{})) != 2 {
+		t.Fatal("wrong model result")
+	}
+	info, _ := os.Stat(filepath.Join(path, ".config/ryoku/ryogami.json"))
+	if info.Mode().Perm() != 0640 {
