+func TestBrokerCatalogDeleteRestorePersistReopenAndPreserveUnrelatedRows(t *testing.T) {
+	root, path, original, commit, expected := catalogFixture(t)
+	entries, event, err := brokerPersistCatalog(root, commit, expected)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 1 || event.Key != "fixture" {
+		t.Fatal("wrong deletion")
+	}
+	catalog := filepath.Join(path, ".cache/ryogami/wallpaper/index.json")
+	data, err := os.ReadFile(catalog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(data, []byte("9007199254740995")) {
+		t.Fatal("unrelated exact number lost")
+	}
+	info, err := os.Stat(catalog)
+	if err != nil || info.Mode().Perm() != 0640 {
+		t.Fatal("metadata lost")
+	}
+	if _, err := os.Stat(filepath.Join(path, ".ryoku-catalog-"+commit.StagingToken+".part")); !os.IsNotExist(err) {
+		t.Fatal("stage remains")
+	}
+	if got := openStore(filepath.Join(path, ".cache/ryogami")); len(got.entries) != 1 {
+		t.Fatal("reopen lost catalog")
+	}
+	if _, _, err := brokerPersistCatalog(root, commit, expected); err == nil {
+		t.Fatal("stale commit repeated")
+	}
+	var rows map[string]json.RawMessage
+	if err := json.Unmarshal(original, &rows); err != nil {
+		t.Fatal(err)
+	}
+	restore := brokerCatalogCommit{ExpectedCatalog: fmt.Sprintf("%x", sha256.Sum256(data)), StagingToken: strings.Repeat("d", 64), Mutation: brokerCatalogMutation{Action: "insert", Key: "fixture", Entry: rows["fixture"]}}
+	entries, event, err = brokerPersistCatalog(root, restore, entries)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 2 || event.Path != filepath.Join(path, "Pictures/sample.png") {
+		t.Fatal("restore row not resolved")
+	}
+	data, err = os.ReadFile(catalog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(data, []byte("9007199254740993")) || !bytes.Contains(data, []byte("9007199254740995")) {
+		t.Fatal("row metadata changed")
+	}
+}
+func TestBrokerCatalogRefusesStaleMemoryCollisionLinksAndUnsupportedMetadata(t *testing.T) {
+	for _, fault := range []string{"stale", "memory", "collision", "link", "metadata"} {
+		t.Run(fault, func(t *testing.T) {
+			root, path, original, commit, entries := catalogFixture(t)
+			catalog := filepath.Join(path, ".cache/ryogami/wallpaper/index.json")
+			stage := filepath.Join(path, ".ryoku-catalog-"+commit.StagingToken+".part")
+			switch fault {
+			case "stale":
+				commit.ExpectedCatalog = strings.Repeat("0", 64)
+			case "memory":
+				delete(entries, "private")
+			case "collision":
+				if err := os.WriteFile(stage, []byte("retain"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "link":
+				if err := os.Rename(catalog, catalog+".private"); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink("index.json.private", catalog); err != nil {
+					t.Fatal(err)
+				}
+			case "metadata":
+				if err := syscall.Setxattr(catalog, "user.fixture", []byte("unsupported"), 0); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if _, _, err := brokerPersistCatalog(root, commit, entries); err == nil {
+				t.Fatal("unsafe commit succeeded")
+			}
+			actual, err := os.ReadFile(catalog)
+			if err != nil || !bytes.Equal(actual, original) {
+				t.Fatal("failed commit changed catalog")
+			}
+			if fault == "metadata" {
+				if _, err := os.Stat(stage); err != nil {
+					t.Fatal("partial stage not retained")
+				}
+			}
+			if fault == "collision" {
+				data, _ := os.ReadFile(stage)
+				if string(data) != "retain" {
+					t.Fatal("stage overwritten")
