+package main
+
+// HTTP metadata has a distinct private owner channel. It never calls
+// buildResult, queues thumbnails, launches a tool, or changes local files.
+// Local cache/content publication remains a separately captured transaction.
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+	"unicode"
+)
+
+type brokerMetadataSearch struct {
+	Query      string                     `json:"query"`
+	Page       uint32                     `json:"page"`
+	Generation uint64                     `json:"generation"`
+	Filters    map[string]json.RawMessage `json:"filters"`
+}
+type brokerMetadataQuery struct {
+	Source string               `json:"source"`
+	Search brokerMetadataSearch `json:"search"`
+}
+type brokerPreparedMetadata struct {
+	ExpectedSettings *string             `json:"expected_settings"`
+	Query            brokerMetadataQuery `json:"query"`
+}
+type brokerMetadataCall struct {
+	Actor     brokerPlayerPin        `json:"actor"`
+	HomeSHA   string                 `json:"account_home_sha256"`
+	RequestID string                 `json:"request_id"`
+	Query     brokerPreparedMetadata `json:"query"`
+	RPCID     int64                  `json:"rpc_id"`
+}
+type brokerMetadataItem struct {
+	ID             string `json:"id"`
+	FullURL        string `json:"fullUrl"`
+	ThumbURL       string `json:"thumbUrl"`
+	Resolution     string `json:"resolution"`
+	FileSize       uint64 `json:"fileSize"`
+	Title          string `json:"title,omitempty"`
+	TrackURL       string `json:"trackUrl,omitempty"`
+	Attribution    string `json:"attribution,omitempty"`
+	AttributionURL string `json:"attributionUrl,omitempty"`
+	DurationSecs   uint64 `json:"durationSecs,omitempty"`
+	Purity         string `json:"purity,omitempty"`
+	Category       string `json:"category,omitempty"`
+}
+type brokerMetadataPage struct {
+	Results     []brokerMetadataItem `json:"results"`
+	LastPage    int                  `json:"lastPage"`
+	CurrentPage int                  `json:"currentPage"`
+	NextCursor  string               `json:"nextCursor,omitempty"`
+}
+type brokerMetadataResponse struct {
+	ID        int64               `json:"id"`
+	RequestID string              `json:"request_id"`
+	Result    *brokerMetadataPage `json:"result,omitempty"`
+	Error     string              `json:"error,omitempty"`
+}
+
+func brokerMetadataText(value string, maximum int) bool {
+	return len(value) <= maximum && !strings.ContainsFunc(value, unicode.IsControl)
+}
+func brokerMetadataID(value string) bool {
+	if len(value) < 1 || len(value) > 96 || value[0] < 'a' || value[0] > 'z' || strings.Contains(value, "--") || value[len(value)-1] == '-' {
+		return false
+	}
+	for _, c := range value {
+		if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
+			return false
+		}
+	}
+	return true
+}
+func (query brokerMetadataQuery) params() (map[string]interface{}, bool) {
+	var allowed []string
+	switch query.Source {
+	case "wallhaven":
+		allowed = []string{"categories", "purity", "sorting", "order", "top_range", "atleast", "atmost", "resolutions", "ratios", "colors", "collection"}
+	case "unsplash":
+		allowed = []string{"order_by", "content_filter", "orientation", "color"}
+	case "pexels":
+		allowed = []string{"orientation", "size", "color"}
+	case "bing":
+		allowed = []string{"market"}
+	case "moewalls", "motionbgs", "ryostore":
+		allowed = []string{}
+	case "repos":
+		allowed = []string{"repository", "branch", "path", "media"}
+	default:
+		return nil, false
+	}
+	if !brokerMetadataText(query.Search.Query, 512) || query.Search.Page < 1 || query.Search.Page > 10000 || query.Search.Generation > uint64(1<<63-1) || len(query.Search.Filters) != len(allowed)+1 {
+		return nil, false
+	}
+	var provider string
+	if json.Unmarshal(query.Search.Filters["provider"], &provider) != nil || provider != query.Source {
+		return nil, false
+	}
+	params := map[string]interface{}{"query": query.Search.Query, "page": int64(query.Search.Page), "generation": int64(query.Search.Generation)}
+	for _, key := range allowed {
+		var value string
+		if json.Unmarshal(query.Search.Filters[key], &value) != nil || !brokerMetadataText(value, 256) {
+			return nil, false
+		}
+		field := key
+		switch key {
+		case "top_range":
+			field = "topRange"
+		case "repository":
+			field = "repo"
+		case "media":
+			field = "type"
+		}
+		params[field] = value
+	}
+	return params, true
+}
