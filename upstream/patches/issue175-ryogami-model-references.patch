+import QtQuick
+
+// Only opaque protected receipts live here; paths and catalog rows stay in the helper.
+QtObject {
+    id: trash
+    required property var transport
+    property var receipts: []
+    property bool busy: false
+    property var entries: []
+    property string nextCursor: ""
+    property string currentCursor: ""
+    property var previousCursors: []
+    property bool loaded: false
+    property string errorMessage: ""
+    readonly property bool canDelete: !busy
+    readonly property bool canRestore: !busy && receipts.length > 0
+    signal failed(string message)
+    signal deleted()
+    signal restored()
+
+    function deleteKey(key) {
+        if (!canDelete || !key)
+            return
+        busy = true
+        transport.call("wall.delete", { key: key }, function(result, error) {
+            trash.busy = false
+            if (error || !result || result.ok !== true
+                    || typeof result.trash_receipt !== "string"
+                    || !/^[0-9a-f]{64}\.[0-9a-f]{64}$/.test(result.trash_receipt)) {
+                trash.failed(error && error.message ? error.message : "")
+                return
+            }
+            trash.receipts = trash.receipts.concat([result.trash_receipt]).slice(-64)
+            trash.deleted()
+        })
+    }
+
+    function restoreLast() {
+        if (canRestore)
+            restoreReceipt(receipts[receipts.length - 1])
+    }
+
+    function restoreReceipt(receipt) {
+        if (busy || typeof receipt !== "string")
+            return
+        const entry = entries.find(item => item.receipt === receipt)
+        if ((!entry && receipts.indexOf(receipt) < 0) || (entry && entry.recovery_required))
+            return
+        busy = true
+        errorMessage = ""
+        transport.call("wall.restore", { receipt: receipt }, function(result, error) {
+            trash.busy = false
+            if (error || !result || result.ok !== true || result.restored !== true) {
+                trash.errorMessage = error && error.message ? error.message : "Restore could not be verified. Review recovery history before retrying."
+                trash.failed(trash.errorMessage)
+                return
+            }
+            const index = trash.receipts.lastIndexOf(receipt)
+            if (index >= 0)
+                trash.receipts = trash.receipts.slice(0, index).concat(trash.receipts.slice(index + 1))
+            trash.entries = trash.entries.filter(item => item.receipt !== receipt)
+            trash.restored()
+        })
+    }
+
+    function refresh() {
+        loadPage("", [])
+    }
+
+    function nextPage() {
+        if (nextCursor)
+            loadPage(nextCursor, previousCursors.concat([currentCursor]).slice(-64))
+    }
+
+    function previousPage() {
+        if (previousCursors.length)
+            loadPage(previousCursors[previousCursors.length - 1], previousCursors.slice(0, -1))
+    }
+
+    function loadPage(cursor, history) {
+        if (busy)
+            return
+        busy = true
+        errorMessage = ""
+        transport.call("wall.trash.list", { cursor: cursor || null }, function(result, error) {
+            trash.busy = false
+            let valid = !error && result && Array.isArray(result.entries) && result.entries.length <= 32
+                && (result.next_cursor === null || (typeof result.next_cursor === "string"
+                    && /^[0-9a-f]{64}$/.test(result.next_cursor) && result.next_cursor !== cursor))
+            const seen = ({})
+            if (valid) {
+                for (const item of result.entries) {
+                    if (!item || typeof item.receipt !== "string" || !/^[0-9a-f]{64}\.[0-9a-f]{64}$/.test(item.receipt)
+                            || seen[item.receipt] || typeof item.label !== "string" || item.label.length > 256
+                            || (item.kind !== "static" && item.kind !== "video") || typeof item.recovery_required !== "boolean"
+                            || !Number.isSafeInteger(item.bytes) || item.bytes < 0 || item.bytes > 34359738368) {
+                        valid = false
+                        break
+                    }
+                    seen[item.receipt] = true
+                }
+            }
+            if (!valid) {
+                trash.errorMessage = error && error.message ? error.message : "Trash history is unavailable. Retry or review recovery history."
+                trash.failed(trash.errorMessage)
+                return
+            }
+            trash.entries = result.entries
+            trash.nextCursor = result.next_cursor || ""
+            trash.currentCursor = cursor
+            trash.previousCursors = history
+            trash.loaded = true
+        })
+    }
+}
