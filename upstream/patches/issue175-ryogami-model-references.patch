+import QtQuick
+import QtTest
+import "../qml" as Picker
+
+TestCase {
+    name: "MediaTrashState"
+    QtObject {
+        id: rpc
+        property var pending: null
+        property string method: ""
+        property var params: null
+        property int calls: 0
+        function call(method, params, callback) {
+            rpc.method = method
+            rpc.params = params
+            rpc.pending = callback
+            ++rpc.calls
+        }
+    }
+    Picker.MediaTrashState { id: trash; transport: rpc }
+    SignalSpy { id: errors; target: trash; signalName: "failed" }
+    SignalSpy { id: deletions; target: trash; signalName: "deleted" }
+    SignalSpy { id: restores; target: trash; signalName: "restored" }
+    readonly property string receipt: "a".repeat(64) + "." + "b".repeat(64)
+    function init() {
+        trash.entries = []
+        trash.nextCursor = ""
+        trash.currentCursor = ""
+        trash.previousCursors = []
+        trash.loaded = false
+        trash.errorMessage = ""
+        trash.receipts = []
+        trash.busy = false
+        rpc.pending = null
+        rpc.calls = 0
+        errors.clear(); deletions.clear(); restores.clear()
+    }
+    function test_delete_restore_and_retry() {
+        trash.deleteKey("fixture")
+        compare(rpc.method, "wall.delete")
+        compare(JSON.stringify(rpc.params), '{"key":"fixture"}')
+        verify(trash.busy)
+        trash.deleteKey("second")
+        compare(rpc.calls, 1)
+        rpc.pending({ok: true, trash_receipt: receipt}, null)
+        compare(deletions.count, 1)
+        verify(trash.canRestore)
+        trash.restoreLast()
+        compare(rpc.method, "wall.restore")
+        compare(JSON.stringify(rpc.params), JSON.stringify({receipt: receipt}))
+        rpc.pending(null, {message: "checkpoint unavailable"})
+        compare(errors.count, 1)
+        compare(trash.receipts.length, 1)
+        verify(trash.canRestore)
+        trash.restoreLast()
+        rpc.pending({ok: true, restored: true}, null)
+        compare(restores.count, 1)
+        compare(trash.receipts.length, 0)
+        verify(!trash.canRestore)
+    }
+    function test_failed_and_malformed_delete_has_no_undo() {
+        for (const result of [null, {ok: true}, {ok: true, trash_receipt: "/tmp/file"}, {ok: false, trash_receipt: receipt}]) {
+            trash.deleteKey("fixture")
+            rpc.pending(result, null)
+            compare(trash.receipts.length, 0)
+            verify(!trash.busy)
+        }
+        compare(errors.count, 4)
+    }
+    function test_bounded_session_undo_does_not_block_durable_deletions() {
+        trash.receipts = Array(64).fill(receipt)
+        verify(trash.canDelete)
+        trash.deleteKey("fixture")
+        compare(rpc.calls, 1)
+        rpc.pending({ok: true, trash_receipt: receipt}, null)
+        compare(trash.receipts.length, 64)
+        trash.restoreLast()
+        rpc.pending({ok: true, restored: true}, null)
+        compare(trash.receipts.length, 63)
+        verify(trash.canDelete)
+    }
+    function entry(receiptValue, recovery) {
+        return {receipt: receiptValue, label: "Fixture", kind: "static", bytes: 48, recovery_required: recovery === true}
+    }
+    function test_restart_refresh_and_selected_restore_preserve_failure() {
+        trash.refresh()
+        compare(rpc.method, "wall.trash.list")
+        compare(JSON.stringify(rpc.params), '{"cursor":null}')
+        rpc.pending({entries: [entry(receipt)], next_cursor: null}, null)
+        verify(trash.loaded)
+        compare(trash.receipts.length, 0)
+        trash.restoreReceipt(receipt)
+        compare(rpc.method, "wall.restore")
+        rpc.pending(null, {message: "pre-checkpoint refused"})
+        compare(trash.entries.length, 1)
+        verify(trash.errorMessage.length > 0)
+        trash.restoreReceipt(receipt)
+        rpc.pending({ok: true, restored: true}, null)
+        compare(trash.entries.length, 0)
+        compare(restores.count, 1)
+    }
+    function test_pagination_and_failure_preserve_current_page() {
+        const cursor = "c".repeat(64)
+        trash.refresh()
+        rpc.pending({entries: [entry(receipt)], next_cursor: cursor}, null)
+        trash.nextPage()
+        compare(rpc.params.cursor, cursor)
+        rpc.pending(null, {message: "busy"})
+        compare(trash.currentCursor, "")
+        compare(trash.entries.length, 1)
+        trash.nextPage()
+        rpc.pending({entries: [], next_cursor: null}, null)
+        compare(trash.currentCursor, cursor)
+        compare(trash.previousCursors.length, 1)
+        trash.previousPage()
+        compare(rpc.params.cursor, null)
+        rpc.pending({entries: [entry(receipt)], next_cursor: cursor}, null)
+        compare(trash.previousCursors.length, 0)
+        compare(trash.entries.length, 1)
+    }
+    function test_invalid_pages_and_partial_receipts_never_dispatch_restore() {
+        trash.entries = [entry(receipt, true)]
+        trash.restoreReceipt(receipt)
+        trash.restoreReceipt("b".repeat(64) + "." + "c".repeat(64))
+        compare(rpc.calls, 0)
+        for (const result of [null, {entries: Array(33).fill(entry(receipt)), next_cursor: null},
+                {entries: [entry(receipt), entry(receipt)], next_cursor: null},
+                {entries: [entry("/tmp/file")], next_cursor: null}, {entries: [], next_cursor: "bad"}]) {
+            trash.refresh()
+            rpc.pending(result, null)
+            compare(trash.entries.length, 1)
+            verify(trash.entries[0].recovery_required)
+            verify(!trash.busy)
+        }
+    }
+}
