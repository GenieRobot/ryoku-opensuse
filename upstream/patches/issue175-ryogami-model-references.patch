+		binary.LittleEndian.PutUint16(acl[at:], uint16(entry[0]))
+		binary.LittleEndian.PutUint16(acl[at+2:], uint16(entry[1]))
+		binary.LittleEndian.PutUint32(acl[at+4:], entry[2])
+	}
+	if err := syscall.Setxattr(target, "system.posix_acl_access", acl, 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := brokerPersistModelReferences(root, commit); err != nil {
+		t.Fatal(err)
+	}
+	actual := make([]byte, 65536)
+	n, err := syscall.Getxattr(target, "system.posix_acl_access", actual)
+	if err != nil || string(actual[:n]) != string(acl) {
+		t.Fatal("ACL lost")
+	}
+	data, _ := os.ReadFile(target)
+	hash := fmt.Sprintf("%x", sha256.Sum256(data))
+	commit.ExpectedConfig = &hash
+	commit.StagingToken = strings.Repeat("d", 64)
+	if err := syscall.Setxattr(target, "user.fixture", []byte("unsupported"), 0); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := brokerPersistModelReferences(root, commit); err == nil {
+		t.Fatal("unenrolled xattr silently lost")
+	}
+	unchanged, _ := os.ReadFile(target)
+	if string(unchanged) != string(data) {
+		t.Fatal("failed stage changed target")
+	}
+	stage, err := os.ReadFile(filepath.Join(path, ".ryoku-model-"+commit.StagingToken+".part"))
+	if err != nil || len(stage) == 0 {
+		t.Fatal("failed stage not retained")
+	}
+	if string(unchanged) == string(original) {
+		t.Fatal("successful prior commit rolled back unexpectedly")
+	}
+}
