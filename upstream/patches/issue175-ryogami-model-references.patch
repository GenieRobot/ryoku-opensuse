+func brokerMetadataSettings(root *os.File) ([]byte, error) {
+	if _, err := brokerModelOwned(root, true); err != nil {
+		return nil, err
+	}
+	config, err := brokerModelOpen(root, ".config", true)
+	if errors.Is(err, syscall.ENOENT) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer config.Close()
+	parent, err := brokerModelOpen(config, "ryoku", true)
+	if errors.Is(err, syscall.ENOENT) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer parent.Close()
+	file, data, _, err := brokerModelRead(parent)
+	if errors.Is(err, syscall.ENOENT) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	file.Close()
+	return data, nil
+}
