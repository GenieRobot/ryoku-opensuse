+#[cfg(test)]
+mod port_tests {
+    #[test]
+    fn xml_dependency_upgrade_preserves_description_entities_and_empty_bodies() {
+        let parsed = crate::parse_protocol(
+            r#"<protocol name="port"><description summary="a &amp; b">before &amp; after &lt;x&gt; &#97;</description></protocol>"#,
+        ).unwrap();
+        let description = parsed.description.unwrap();
+        assert_eq!(description.summary.as_deref(), Some("a & b"));
+        assert_eq!(description.text.as_deref(), Some("before & after <x> a"));
+        let empty =
+            crate::parse_protocol(r#"<protocol name="port"><description summary="empty"></description></protocol>"#)
+                .unwrap();
+        assert!(empty.description.unwrap().text.is_none());
+    }
+
+    #[test]
+    fn malformed_description_returns_an_error() {
+        assert!(
+            crate::parse_protocol(r#"<protocol name="port"><description>&unknown;</description></protocol>"#,).is_err()
+        );
+    }
+}
