+#[cfg(test)]
+mod port_tests {
+    use super::*;
+    use std::io::Read;
+    use std::os::unix::net::UnixStream;
+    use tokio::io::AsyncWriteExt;
+
+    #[tokio::test]
+    async fn registered_owned_descriptor_writes_and_closes_without_losing_ownership() {
+        let (sender, mut receiver) = UnixStream::pair().unwrap();
+        receiver.set_read_timeout(Some(std::time::Duration::from_secs(2))).unwrap();
+        let mut writer = FdWrite::try_from(OwnedFd::from(sender)).unwrap();
+        let payload = b"synthetic clipboard bytes";
+        tokio::time::timeout(std::time::Duration::from_secs(2), writer.write_all(payload))
+            .await.unwrap().unwrap();
+        let mut actual = vec![0; payload.len()];
+        receiver.read_exact(&mut actual).unwrap();
+        assert_eq!(actual, payload);
+        drop(writer);
+        assert_eq!(receiver.read(&mut [0]).unwrap(), 0);
+    }
+}
