+func brokerConsumeApply(reason, typ, path string, outputs []string, mute map[string]bool, volume map[string]int, record bool) bool {
+	brokerApply.Lock()
+	defer brokerApply.Unlock()
+	if outputs == nil {
+		outputs = []string{}
+	}
+	if mute == nil {
+		mute = map[string]bool{}
+	}
+	if volume == nil {
