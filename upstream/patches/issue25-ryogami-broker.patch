+func resetManualPauseFixture(t *testing.T) {
+	t.Helper()
+	pauseState.mu.Lock()
+	oldManual, oldActive, oldApplied := pauseState.manual, pauseState.active, pauseState.applied
+	pauseState.manual, pauseState.active, pauseState.applied = nil, false, false
+	pauseState.mu.Unlock()
+	t.Cleanup(func() {
