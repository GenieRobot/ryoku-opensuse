+func pauseFixtureState(t *testing.T, pid int, stopped bool) {
+	t.Helper()
+	until := time.Now().Add(2 * time.Second)
+	for {
+		data, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+		if err != nil {
+			t.Fatal(err)
+		}
+		state := strings.Fields(string(data)[strings.LastIndex(string(data), ") ")+2:])[0]
+		if (state == "T") == stopped {
+			return
+		}
+		if time.Now().After(until) {
+			t.Fatalf("player state=%s want stopped=%v", state, stopped)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
