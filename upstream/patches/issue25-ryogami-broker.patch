+
+func brokerAutomaticRequest(params map[string]interface{}) bool {
+	conn, err := net.DialTimeout("unix", socketPath(), time.Second)
+	if err != nil {
+		return false
+	}
+	defer conn.Close()
+	u, ok := conn.(*net.UnixConn)
+	if !ok {
+		return false
+	}
+	raw, err := u.SyscallConn()
+	if err != nil {
+		return false
+	}
+	var peer *syscall.Ucred
+	var peerErr error
+	if raw.Control(func(fd uintptr) {
+		peer, peerErr = syscall.GetsockoptUcred(int(fd), syscall.SOL_SOCKET, syscall.SO_PEERCRED)
+	}) != nil || peerErr != nil || peer == nil || int(peer.Pid) != os.Getppid() {
+		return false
+	}
+	_ = conn.SetDeadline(time.Now().Add(5 * time.Second))
+	request, _ := json.Marshal(map[string]interface{}{"method": "broker.automatic", "params": params, "id": 0})
+	if _, err = fmt.Fprintf(conn, "%s\n", request); err != nil {
+		return false
+	}
+	line, err := bufio.NewReader(conn).ReadBytes('\n')
+	if err != nil || len(line) > 65536 {
