+// The audio permit is separate from apply and is consumed exactly once before
+// state inspection. Active assignments and shared output fallback follow the
+// upstream setAudio selection rules; external players retain their own owner.
+func (a brokerAudio) valid() bool {
+	if (a.Mute == nil && a.Volume == nil) || (a.Volume != nil && (*a.Volume < 0 || *a.Volume > 100)) || len(a.Outputs) > 16 {
+		return false
+	}
+	seen := map[string]bool{}
+	for _, output := range a.Outputs {
+		if output == "" || output == "*" || len(output) > 128 || seen[output] {
+			return false
+		}
+		for _, c := range output {
+			if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strings.ContainsRune("-_.:", c)) {
+				return false
+			}
+		}
+		seen[output] = true
+	}
+	return true
+}
+
