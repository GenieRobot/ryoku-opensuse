+func (d *daemon) brokerApproved(conn net.Conn) {
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(30 * time.Second))
+	r := bufio.NewReader(io.LimitReader(conn, 4*65536+4097))
