+// Manual playback has its own permit. Automatic rules and external paper
+// providers retain their independently owned authorization routes.
+func (d *daemon) brokerManualPause(p brokerPause, pins []brokerPlayerPin) (map[string]interface{}, error) {
+	if pins == nil {
+		pins = []brokerPlayerPin{}
+	}
+	if !p.valid() || len(pins) > 64 {
+		return nil, fmt.Errorf("invalid manual playback action")
+	}
+	if d.paper != nil && d.paper.running() {
+		return nil, fmt.Errorf("external wallpaper pause requires issue175 provider authorization")
+	}
+	expected := map[int]uint64{}
+	for _, pin := range pins {
+		if pin.PID <= 0 || pin.Start == 0 || expected[pin.PID] != 0 {
+			return nil, fmt.Errorf("invalid linked player identity")
+		}
+		expected[pin.PID] = pin.Start
+	}
+	processes := map[int]*os.Process{}
+	if d.video != nil {
+		d.video.mu.Lock()
+		for _, player := range d.video.procs {
+			if player.cmd == nil || player.cmd.Process == nil {
+				continue
+			}
+			process := player.cmd.Process
+			start, err := brokerPlayerStart(process.Pid)
+			if err != nil || expected[process.Pid] != start || process.Signal(syscall.Signal(0)) != nil {
+				d.video.mu.Unlock()
+				return nil, fmt.Errorf("native player identity changed before playback control")
+			}
+			processes[process.Pid] = process
+		}
+		d.video.mu.Unlock()
+	}
+	if len(processes) != len(expected) {
+		return nil, fmt.Errorf("linked native player set changed")
+	}
+	pauseState.mu.Lock()
+	pauseLocked := true
+	defer func() {
+		if pauseLocked {
+			pauseState.mu.Unlock()
+		}
+	}()
+	manual := map[string]bool{}
+	for key, value := range pauseState.manual {
+		manual[key] = value
+	}
+	if len(p.Outputs) == 0 || contains(p.Outputs, "*") {
+		manual = map[string]bool{}
+		if *p.Paused {
+			manual["*"] = true
+		}
+	} else {
+		for _, output := range p.Outputs {
+			if *p.Paused {
+				manual[output] = true
+			} else {
+				delete(manual, output)
+			}
+		}
+	}
+	effective := pauseState.active || len(manual) != 0
+	if effective != pauseState.applied {
+		signal := syscall.SIGCONT
+		if effective {
+			signal = syscall.SIGSTOP
+		}
+		// os.Process retains the process identity acquired by Go's Linux
+		// spawn/pidfd support. Never signal a raw negative/reusable group PID.
+		for _, process := range processes {
+			if err := process.Signal(signal); err != nil {
+				return nil, fmt.Errorf("native player signal failed; linked action remains failed: %w", err)
+			}
+		}
+	}
+	pauseState.manual = manual
+	pauseState.applied = effective
+	pauseState.mu.Unlock()
+	pauseLocked = false
+	if d.surface != nil {
+		d.surface.setPaused(effective)
+	}
+	d.broadcastPlaybackStatus(effective, nil)
+	return map[string]interface{}{"paused": *p.Paused, "effective_paused": effective, "player_pins": pins}, nil
+}
+func brokerPlayerStart(pid int) (uint64, error) {
+	data, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return 0, err
+	}
+	end := strings.LastIndex(string(data), ") ")
+	if end < 0 {
+		return 0, fmt.Errorf("invalid native player stat")
+	}
+	fields := strings.Fields(string(data)[end+2:])
+	if len(fields) < 20 {
+		return 0, fmt.Errorf("missing native player identity")
+	}
+	return strconv.ParseUint(fields[19], 10, 64)
+}
