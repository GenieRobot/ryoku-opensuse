+func TestAudioSecondReplacementFailureCompensatesOrReportsRecovery(t *testing.T) {
+	for _, failure := range []string{"compensated", "compensation-failed", "prior-absence"} {
+		t.Run(failure, func(t *testing.T) {
+			dir := t.TempDir()
+			workspace := filepath.Join(dir, "workspaces.json")
+			outputs := filepath.Join(dir, "outputs.json")
+			oldWorkspace := []byte("{\"assignments\":{}}\n")
+			oldOutputs := []byte("{\"*\":{\"type\":\"video\",\"volume\":80}}\n")
+			if failure != "prior-absence" {
+				if err := os.WriteFile(workspace, oldWorkspace, 0o600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if err := os.WriteFile(outputs, oldOutputs, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			replacements := []audioReplacement{{path: workspace, value: map[string]interface{}{"changed": true}}, {path: outputs, value: map[string]interface{}{"changed": true}}}
+			calls := 0
+			err := replaceAudioState(replacements, func(path string, value interface{}) error {
+				calls++
+				if calls == 2 {
+					got, _ := os.ReadFile(workspace)
+					if string(got) == string(oldWorkspace) {
+						t.Fatal("fault did not follow first replacement")
+					}
+					return os.ErrPermission
+				}
+				return saveJSONChecked(path, value)
+			}, func(before audioReplacement) error {
+				if failure == "compensation-failed" && before.path == workspace {
+					return os.ErrPermission
+				}
+				return restoreAudioState(before)
+			})
+			if err == nil || calls != 2 {
+				t.Fatalf("partial write was accepted: %v %d", err, calls)
+			}
+			gotOutputs, _ := os.ReadFile(outputs)
+			if string(gotOutputs) != string(oldOutputs) {
+				t.Fatal("outputs preimage lost")
+			}
+			gotWorkspace, readErr := os.ReadFile(workspace)
+			if failure == "compensation-failed" {
+				if !strings.Contains(err.Error(), "linked recovery is required") || string(gotWorkspace) == string(oldWorkspace) {
+					t.Fatal("failed compensation hidden")
+				}
+			} else if failure == "prior-absence" {
+				if !os.IsNotExist(readErr) {
+					t.Fatal("prior absence not restored")
+				}
+			} else if string(gotWorkspace) != string(oldWorkspace) {
+				t.Fatal("workspace preimage not restored")
+			}
+			info, _ := os.Stat(outputs)
+			if info.Mode().Perm() != 0o600 {
+				t.Fatal("mode changed")
+			}
+		})
+	}
+}
