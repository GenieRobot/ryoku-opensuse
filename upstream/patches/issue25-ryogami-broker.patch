+			key := workspaceKey(target.Provider, target.ID)
+			typ := "static"
+			if refusal == "external" {
+				typ = "we"
+			}
+			d.native.workspaces.state.Assignments[key] = workspaceWall{Provider: target.Provider, ID: target.ID, Type: typ, Path: img, Volume: 80}
+			d.native.workspaces.active[target.Output] = target
+			d.native.workspaces.saveLocked()
+			if strings.HasSuffix(refusal, "-workspaces") {
+				path = d.native.workspaces.path()
+			}
+			outputsPath := filepath.Join(d.native.cfg.cacheDir(), "outputs.json")
+			outputsBefore, _ := os.ReadFile(outputsPath)
+			sentinel := filepath.Join(d.root, "sentinel.json")
+			if refusal != "external" {
+				data, _ := os.ReadFile(path)
