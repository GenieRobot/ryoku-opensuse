+
+// Optional automatic operations ask the Rust owner for their own typed route;
+// they never inherit a wall.apply approval or execute a shell hook implicitly.
+func brokerAutomaticAllowed(action string) bool {
+	return brokerAutomaticRequest(map[string]interface{}{"action": action})
