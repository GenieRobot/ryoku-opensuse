+	if err := json.Unmarshal([]byte(got), &result); err != nil {
+		t.Fatal(err)
+	}
+	if result["result"].(map[string]interface{})["ok"] != true {
+		t.Fatal("upstream audio success shape changed")
+	}
+	if !strings.Contains(got, `"audio_written"`) || !strings.Contains(got, `"workspaces"`) || !strings.Contains(got, `"outputs"`) {
+		t.Fatal(got)
+	}
+	outputs := map[string]map[string]interface{}{}
+	loadJSON(filepath.Join(d.native.cfg.cacheDir(), "outputs.json"), &outputs)
+	ws := workspaceWallState{}
+	loadJSON(d.native.workspaces.path(), &ws)
+	if outputs["*"]["mute"] != true || outputs["*"]["volume"] != float64(25) || !ws.Assignments[key].Mute || ws.Assignments[key].Volume != 25 {
+		t.Fatalf("audio not persisted: %+v %+v", outputs, ws)
+	}
+	if _, err := d.native.brokerSetAudio(audio); err == nil {
+		t.Fatal("permit reused without private channel")
+	}
+	// Named outputs claimed by workspaces do not alter the shared fallback.
+	got = d.approvedAction(53, "wall.set_audio", brokerAudio{Outputs: []string{"DP-1"}, Volume: intPtrForAudio(40)})
+	if !strings.Contains(got, `"audio_written"`) || strings.Contains(got, `"outputs"`) {
+		t.Fatal(got)
+	}
+	loadJSON(filepath.Join(d.native.cfg.cacheDir(), "outputs.json"), &outputs)
+	if outputs["*"]["volume"] != float64(25) {
+		t.Fatal("claimed output changed fallback")
+	}
+	if d.native.surface.snapshot().Default.Volume != 40 {
+		t.Fatal("live audio frame was not republished")
+	}
+}
+func boolPtrForAudio(v bool) *bool { return &v }
+func intPtrForAudio(v int) *int    { return &v }
