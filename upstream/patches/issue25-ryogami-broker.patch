+// Preserve the wallpaper-driven stage/theme feature through its Rust-owned
+// automatic-action handoff. Issue176 owns execution, the complete declared
+// write envelope and linked checkpoint; a wallpaper frame is not permission.
+func wallpaperHandoff(action string, frame ryogamiFrame) {
+	request, err := json.Marshal(map[string]interface{}{
+		"method": "broker.automatic", "params": map[string]interface{}{"action": action, "frame": frame}, "id": 0,
+	})
+	if err != nil {
