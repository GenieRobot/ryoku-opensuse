+}
+type brokerWorkspace struct {
+	Request      brokerWorkspaceRequest `json:"request"`
+	Provider     string                 `json:"provider"`
+	Target       brokerWorkspaceTarget  `json:"target"`
+	Active       bool                   `json:"active"`
+	Wallpaper    *brokerWorkspaceWall   `json:"wallpaper"`
+	WorkspaceSHA *string                `json:"workspace_sha256"`
+	OutputsSHA   *string                `json:"outputs_sha256"`
+	RemoveKeys   []string               `json:"remove_keys"`
+}
+
+func (p *brokerWorkspace) valid() bool {
+	if p.Provider != "hyprland" || (p.Request.Operation != "assign" && p.Request.Operation != "unassign") || p.Target.ID == "" || p.Target.Output == "" || len(p.Target.ID) > 128 || len(p.Target.Name) > 256 || len(p.Target.Output) > 128 || len(p.RemoveKeys) > 2 {
+		return false
+	}
+	for _, value := range []string{p.Target.ID, p.Target.Name, p.Target.Output} {
+		if strings.IndexFunc(value, unicode.IsControl) >= 0 {
+			return false
+		}
+	}
+	if p.Request.Workspace.ID != "" && p.Request.Workspace.ID != p.Target.ID {
+		return false
+	}
+	if p.Request.Workspace.Output != "" && p.Request.Workspace.Output != p.Target.Output {
+		return false
+	}
+	if p.Request.Workspace.ID == "" && !p.Active {
+		return false
+	}
+	if p.Request.Wallpaper != nil {
+		requested := p.Request.Wallpaper
+		resolved := p.Wallpaper
+		if p.Request.Operation != "assign" || resolved == nil || requested.Type != resolved.Type || requested.Path != resolved.Path || requested.Mute != nil && *requested.Mute != resolved.Mute || requested.Volume != nil && *requested.Volume != resolved.Volume {
+			return false
+		}
+	}
+	keys := map[string]bool{}
+	for _, key := range p.RemoveKeys {
+		if key == "" || len(key) > 256 || strings.IndexFunc(key, unicode.IsControl) >= 0 || keys[key] {
+			return false
+		}
+		keys[key] = true
+	}
+	if p.Request.Operation == "assign" && p.Wallpaper == nil {
+		return false
+	}
+	if p.Wallpaper != nil {
+		w := p.Wallpaper
+		if (w.Type != "static" && w.Type != "video") || !filepath.IsAbs(w.Path) || len(w.Path) > 4096 || strings.IndexFunc(w.Path, unicode.IsControl) >= 0 || w.Volume < 0 || w.Volume > 100 {
+			return false
+		}
+	}
+	for _, hash := range []*string{p.WorkspaceSHA, p.OutputsSHA} {
+		if hash != nil {
+			if len(*hash) != 64 {
+				return false
+			}
+			for _, c := range *hash {
+				if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+func boundWorkspaceState(path string, expected *string, maximum int64) ([]byte, error) {
+	fd, err := syscall.Open(path, syscall.O_RDONLY|syscall.O_NOFOLLOW|syscall.O_CLOEXEC|syscall.O_NONBLOCK, 0)
+	if os.IsNotExist(err) && expected == nil {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !info.Mode().IsRegular() || !ok || stat.Uid != uint32(os.Geteuid()) || stat.Nlink != 1 || info.Size() > maximum || expected == nil {
+		return nil, fmt.Errorf("workspace state changed before authorized call")
+	}
+	bytes, err := io.ReadAll(io.LimitReader(file, maximum+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(bytes)) > maximum || fmt.Sprintf("%x", sha256.Sum256(bytes)) != *expected {
+		return nil, fmt.Errorf("workspace state no longer matches linked preparation")
+	}
+	return bytes, nil
+}
+func (d *daemon) brokerWorkspaceApply(p *brokerWorkspace) (map[string]interface{}, error) {
+	return d.brokerWorkspaceWithPaint(p, func() error {
+		if p.Wallpaper == nil {
+			return nil
+		}
+		w := p.Wallpaper
+		return d.applyWallpaperPrepared("workspace", w.Type, w.Path, "set", []string{p.Target.Output}, map[string]bool{p.Target.Output: w.Mute}, map[string]int{p.Target.Output: w.Volume}, false)
+	})
+}
+func (d *daemon) brokerWorkspaceWithPaint(p *brokerWorkspace, paint func() error) (map[string]interface{}, error) {
+	if !p.valid() {
+		return nil, fmt.Errorf("invalid prepared manual workspace action")
+	}
+	workspacePath := d.workspaces.path()
+	before, err := boundWorkspaceState(workspacePath, p.WorkspaceSHA, 16*1024*1024)
+	if err != nil {
+		return nil, err
+	}
+	if _, err = boundWorkspaceState(filepath.Join(d.config().cacheDir(), "outputs.json"), p.OutputsSHA, 4*1024*1024); err != nil {
+		return nil, err
+	}
+	state := workspaceWallState{Version: workspaceStateVersion, Assignments: map[string]workspaceWall{}}
+	if before != nil {
+		if err = json.Unmarshal(resolvedJSON(before), &state); err != nil {
+			return nil, err
+		}
+		if state.Assignments == nil {
+			return nil, fmt.Errorf("invalid captured workspace assignments")
+		}
+	}
+	old := workspaceWallState{Version: state.Version, Assignments: map[string]workspaceWall{}}
+	for key, wall := range state.Assignments {
+		old.Assignments[key] = wall
+	}
+	for _, key := range p.RemoveKeys {
+		if _, exists := state.Assignments[key]; !exists {
+			return nil, fmt.Errorf("prepared workspace assignment disappeared")
+		}
+	}
+	if p.Wallpaper != nil {
+		if _, err = os.Stat(p.Wallpaper.Path); err != nil {
+			return nil, err
+		}
+	}
+	for _, key := range p.RemoveKeys {
+		delete(state.Assignments, key)
+	}
+	result := map[string]interface{}{"removed": len(p.RemoveKeys) > 0}
+	if p.Request.Operation == "assign" {
+		w := p.Wallpaper
+		wall := workspaceWall{Provider: p.Provider, ID: p.Target.ID, Name: p.Target.Name, Output: p.Target.Output, Type: w.Type, Path: w.Path, Mute: w.Mute, Volume: w.Volume}
+		state.Assignments[workspaceKey(p.Provider, p.Target.ID)] = wall
+		result = map[string]interface{}{"assignment": wall}
+	}
+	changed := p.Request.Operation == "assign" || len(p.RemoveKeys) > 0
+	if changed {
+		if err = os.MkdirAll(filepath.Dir(workspacePath), 0o755); err != nil {
+			return nil, err
+		}
+		if err = saveJSONChecked(workspacePath, state); err != nil {
+			return nil, err
+		}
+	}
+	d.workspaces.mu.Lock()
+	previousActive, hadActive := d.workspaces.active[p.Target.Output]
+	previousProvider := d.workspaces.provider
+	activeWasNil := d.workspaces.active == nil
+	d.workspaces.state = state
+	if p.Active {
+		if d.workspaces.active == nil {
+			d.workspaces.active = map[string]workspaceTarget{}
+		}
+		d.workspaces.active[p.Target.Output] = workspaceTarget{Provider: p.Provider, ID: p.Target.ID, Name: p.Target.Name, Output: p.Target.Output}
+		d.workspaces.provider = p.Provider
+	}
+	d.workspaces.mu.Unlock()
+	if changed && p.Active {
+		if err = paint(); err != nil {
+			compensation := restoreAudioState(audioReplacement{path: workspacePath, before: before, existed: p.WorkspaceSHA != nil})
+			d.workspaces.mu.Lock()
+			d.workspaces.state = old
+			if p.Active {
+				if activeWasNil {
+					d.workspaces.active = nil
+				} else if hadActive {
+					d.workspaces.active[p.Target.Output] = previousActive
+				} else {
+					delete(d.workspaces.active, p.Target.Output)
+				}
+				d.workspaces.provider = previousProvider
+			}
+			d.workspaces.mu.Unlock()
+			if compensation != nil {
+				return nil, fmt.Errorf("workspace repaint failed (%v); compensation failed (%v); linked recovery required", err, compensation)
+			}
+			return nil, fmt.Errorf("workspace repaint failed (%v); prior assignment compensated; operation remains failed", err)
+		}
+	}
+	return result, nil
+}
