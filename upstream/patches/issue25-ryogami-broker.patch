+func TestE2EBrokerAudioRefusesExternalTargetsAndLinkedStateWithoutWrites(t *testing.T) {
+	for _, refusal := range []string{"external", "symlink", "hardlink", "symlink-workspaces", "hardlink-workspaces"} {
+		t.Run(refusal, func(t *testing.T) {
+			d := startDaemon(t)
+			img := filepath.Join(d.root, "wall.png")
+			writeE2EPNG(t, img)
+			if got := d.apply(60, img); !strings.Contains(got, `"applied"`) {
+				t.Fatal(got)
+			}
+			path := filepath.Join(d.native.cfg.cacheDir(), "outputs.json")
+			target := workspaceTarget{Provider: "hyprland", ID: "1", Output: "DP-1"}
+			key := workspaceKey(target.Provider, target.ID)
+			typ := "static"
+			if refusal == "external" {
+				typ = "we"
+			}
+			d.native.workspaces.state.Assignments[key] = workspaceWall{Provider: target.Provider, ID: target.ID, Type: typ, Path: img, Volume: 80}
+			d.native.workspaces.active[target.Output] = target
+			d.native.workspaces.saveLocked()
+			if strings.HasSuffix(refusal, "-workspaces") {
+				path = d.native.workspaces.path()
+			}
+			outputsPath := filepath.Join(d.native.cfg.cacheDir(), "outputs.json")
+			outputsBefore, _ := os.ReadFile(outputsPath)
+			sentinel := filepath.Join(d.root, "sentinel.json")
+			if refusal != "external" {
+				data, _ := os.ReadFile(path)
+				if err := os.WriteFile(sentinel, data, 0o600); err != nil {
+					t.Fatal(err)
+				}
+				os.Remove(path)
+				var err error
+				if strings.HasPrefix(refusal, "symlink") {
+					err = os.Symlink(sentinel, path)
+				} else {
+					err = os.Link(sentinel, path)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			before, _ := os.ReadFile(path)
+			wsBefore, _ := os.ReadFile(d.native.workspaces.path())
+			got := d.approvedAction(61, "wall.set_audio", brokerAudio{Outputs: []string{}, Mute: boolPtrForAudio(true)})
+			if !strings.Contains(got, `"error"`) {
+				t.Fatal(got)
+			}
+			after, _ := os.ReadFile(path)
+			wsAfter, _ := os.ReadFile(d.native.workspaces.path())
+			outputsAfter, _ := os.ReadFile(outputsPath)
+			if string(before) != string(after) || string(wsBefore) != string(wsAfter) || string(outputsBefore) != string(outputsAfter) {
+				t.Fatal("refused audio wrote persistent state")
+			}
+			if refusal != "external" {
+				sentinelAfter, _ := os.ReadFile(sentinel)
+				if string(before) != string(sentinelAfter) {
+					t.Fatal("linked sentinel overwritten")
+				}
+				os.Remove(path)
+				if err := os.WriteFile(path, before, 0o600); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				wall := d.native.workspaces.state.Assignments[key]
+				wall.Type = "static"
+				d.native.workspaces.state.Assignments[key] = wall
+				d.native.workspaces.saveLocked()
+			}
+			got = d.approvedAction(62, "wall.set_audio", brokerAudio{Outputs: []string{}, Mute: boolPtrForAudio(true)})
+			if !strings.Contains(got, `"audio_written"`) {
+				t.Fatal(got)
+			}
+		})
+	}
+}
+func TestAtomicStateWritePreservesModeAndPredictableTempSentinel(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "outputs.json")
+	sentinel := filepath.Join(dir, "sentinel")
+	if err := os.WriteFile(sentinel, []byte("sentinel"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(sentinel, path+".tmp"); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte("old"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := atomicStateWrite(path, []byte("new")); err != nil {
+		t.Fatal(err)
+	}
+	info, _ := os.Stat(path)
+	if info.Mode().Perm() != 0o600 {
+		t.Fatal("private mode changed")
+	}
+	got, _ := os.ReadFile(sentinel)
+	if string(got) != "sentinel" {
+		t.Fatal("predictable temp link followed")
+	}
+	os.Remove(path)
+	os.Symlink(sentinel, path)
+	if err := atomicStateWrite(path, []byte("bad")); err == nil {
+		t.Fatal("leaf symlink accepted")
+	}
+	got, _ = os.ReadFile(sentinel)
+	if string(got) != "sentinel" {
+		t.Fatal("leaf link followed")
+	}
+	files, _ := filepath.Glob(filepath.Join(dir, ".ryogami-state-*"))
+	if len(files) != 0 {
+		t.Fatal("temporary files leaked")
+	}
 }
