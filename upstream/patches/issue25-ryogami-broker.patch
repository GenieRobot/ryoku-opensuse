+		d.workspaces.mu.Lock()
+		defer d.workspaces.mu.Unlock()
+		ws = workspaceWallState{Version: d.workspaces.state.Version, Assignments: map[string]workspaceWall{}}
+		for key, value := range d.workspaces.state.Assignments {
+			ws.Assignments[key] = value
+		}
+		keys := map[string]bool{}
+		for output, active := range d.workspaces.active {
+			if len(a.Outputs) > 0 && !contains(a.Outputs, output) {
+				continue
+			}
+			key := workspaceKey(active.Provider, active.ID)
+			wall, exists := ws.Assignments[key]
+			if !exists {
+				continue
+			}
+			if wall.Type != "static" && wall.Type != "video" {
+				return nil, fmt.Errorf("external wallpaper audio requires the provider route (#175)")
+			}
+			claimed[output] = true
+			if a.Mute != nil {
+				wall.Mute = *a.Mute
+			}
+			if a.Volume != nil {
+				wall.Volume = *a.Volume
+			}
+			ws.Assignments[key] = wall
+			if !keys[key] {
+				targets = append(targets, brokerAudioTarget{"workspaces", key})
+				keys[key] = true
+			}
+		}
+	}
+	allClaimed := len(a.Outputs) > 0
+	for _, output := range a.Outputs {
+		if !claimed[output] {
+			allClaimed = false
+		}
+	}
+	outputs := append([]string(nil), a.Outputs...)
+	if _, shared := state["*"]; shared && len(outputs) > 0 && !allClaimed {
+		outputs = append(outputs, "*")
+	}
+	for key, entry := range state {
+		if claimed[key] || (key == "*" && allClaimed) || (len(outputs) > 0 && !contains(outputs, key)) {
+			continue
+		}
+		if entry["type"] != "static" && entry["type"] != "video" {
+			return nil, fmt.Errorf("external wallpaper audio requires the provider route (#175)")
+		}
+		if a.Mute != nil {
+			entry["mute"] = *a.Mute
+		}
+		if a.Volume != nil {
+			entry["volume"] = *a.Volume
+		}
+		targets = append(targets, brokerAudioTarget{"outputs", key})
+	}
+	if len(targets) == 0 || len(targets) > 32 {
+		return nil, fmt.Errorf("choose 1 to 32 active wallpaper state targets before changing audio")
+	}
+	for _, target := range targets {
+		if target.Key == "" || len(target.Key) > 128 || strings.IndexFunc(target.Key, unicode.IsControl) >= 0 {
+			return nil, fmt.Errorf("wallpaper audio target exceeds recovery receipt capacity")
+		}
+	}
+	// Preflight every destination before the first write. A later I/O failure
+	// remains a failed linked operation; Rust refreezes and records recovery.
+	for _, target := range targets {
+		destination := path
+		if target.State == "workspaces" {
+			destination = d.workspaces.path()
+		}
+		if info, err := os.Lstat(destination); err == nil {
+			st, ok := info.Sys().(*syscall.Stat_t)
+			if !info.Mode().IsRegular() || !ok || st.Nlink != 1 {
+				return nil, fmt.Errorf("audio state destination must be a regular file with one link")
+			}
+		} else if !os.IsNotExist(err) {
+			return nil, err
+		}
+	}
+	writesOutputs, writesWorkspaces := false, false
+	for _, target := range targets {
+		if target.State == "outputs" {
+			writesOutputs = true
+		} else {
+			writesWorkspaces = true
+		}
+	}
+	replacements := []audioReplacement{}
+	if writesWorkspaces {
+		replacements = append(replacements, audioReplacement{path: d.workspaces.path(), value: ws})
+	}
+	if writesOutputs {
+		replacements = append(replacements, audioReplacement{path: path, value: state})
+	}
+	if err := replaceAudioState(replacements, saveJSONChecked, restoreAudioState); err != nil {
+		return nil, err
+	}
+	if writesWorkspaces {
+		d.workspaces.state = ws
+	}
+	d.surface.setAudio(a.Mute, a.Volume, a.Outputs)
+	sort.Slice(targets, func(i, j int) bool {
+		if targets[i].State == targets[j].State {
+			return targets[i].Key < targets[j].Key
+		}
+		return targets[i].State < targets[j].State
+	})
+	return targets, nil
+}
+
+// Replacements remain inside the already captured exact write set. Compensation
+// restores prior bytes/absence if a later replacement fails. Even successful
+// compensation returns failure; Rust retains Applying/MayHaveMutated history.
+type audioReplacement struct {
+	path    string
+	value   interface{}
+	before  []byte
+	existed bool
+}
+
+func restoreAudioState(replacement audioReplacement) error {
+	if replacement.existed {
+		return atomicStateWrite(replacement.path, replacement.before)
+	}
+	err := os.Remove(replacement.path)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	return err
+}
+func replaceAudioState(replacements []audioReplacement, write func(string, interface{}) error, restore func(audioReplacement) error) error {
+	for i := range replacements {
+		before, err := os.ReadFile(replacements[i].path)
+		if err != nil && !os.IsNotExist(err) {
+			return err
+		}
+		replacements[i].before = before
+		replacements[i].existed = err == nil
+	}
+	for i, replacement := range replacements {
+		if err := write(replacement.path, replacement.value); err != nil {
+			var compensation error
+			// Include the failing destination: a provider I/O error must not
+			// be interpreted as proof that its destination stayed unchanged.
+			for j := i; j >= 0; j-- {
+				if restoreErr := restore(replacements[j]); restoreErr != nil {
+					compensation = restoreErr
+				}
+			}
+			if compensation != nil {
+				return fmt.Errorf("audio persistence failed (%v); compensation failed (%v); linked recovery is required", err, compensation)
+			}
+			return fmt.Errorf("audio persistence failed (%v); prior state compensated; operation remains failed", err)
+		}
+	}
+	return nil
+}
+
+type brokerWorkspaceTarget struct {
+	ID     string `json:"id"`
+	Name   string `json:"name"`
