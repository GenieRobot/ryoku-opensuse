+// The port's Rust writer owns every public connection and all authorization.
+// This inherited control channel has no filesystem socket fallback.
+func brokerControl() (*net.UnixConn, error) {
+	if os.Getenv("RYOKU_WALLPAPER_BROKER_FD") != "0" {
+		return nil, fmt.Errorf("Ryogami requires the Rust appearance broker")
+	}
+	parent := os.Getppid()
+	exe, err := os.Readlink(fmt.Sprintf("/proc/%d/exe", parent))
+	if err != nil || exe != "/usr/libexec/ryoku/ryoku-writer" {
+		return nil, fmt.Errorf("invalid appearance broker executable")
+	}
+	conn, err := net.FileConn(os.Stdin)
+	if err != nil {
+		return nil, err
+	}
+	control, ok := conn.(*net.UnixConn)
+	if !ok {
+		conn.Close()
+		return nil, fmt.Errorf("appearance broker fd is not Unix")
+	}
+	raw, err := control.SyscallConn()
+	if err != nil {
+		control.Close()
+		return nil, err
+	}
+	var peer *syscall.Ucred
+	var peerErr error
+	if err = raw.Control(func(fd uintptr) {
+		peer, peerErr = syscall.GetsockoptUcred(int(fd), syscall.SOL_SOCKET, syscall.SO_PEERCRED)
+	}); err != nil || peerErr != nil || peer == nil || int(peer.Pid) != parent || int(peer.Uid) != os.Geteuid() {
+		control.Close()
+		return nil, fmt.Errorf("appearance control peer mismatch")
+	}
+	return control, nil
+}
