+// askTransport authenticates the Unix peer before any request is sent.
+func askTransport() (*http.Client, bool) {
+	socket := os.Getenv("RYOKU_RASHIN_ASK_SOCKET")
+	if socket == "" {
+		return &http.Client{Timeout: 5 * time.Minute}, false
+	}
+	transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		conn, err := (&net.Dialer{}).DialContext(ctx, "unix", socket)
+		if err != nil {
+			return nil, err
+		}
+		u, ok := conn.(*net.UnixConn)
+		if !ok {
+			conn.Close()
+			return nil, fmt.Errorf("invalid private Ask socket")
+		}
+		raw, err := u.SyscallConn()
+		if err != nil {
+			conn.Close()
+			return nil, err
+		}
+		var cred *syscall.Ucred
+		var check error
+		err = raw.Control(func(fd uintptr) {
+			cred, check = syscall.GetsockoptUcred(int(fd), syscall.SOL_SOCKET, syscall.SO_PEERCRED)
+		})
+		if err != nil || check != nil || cred == nil || cred.Uid != uint32(os.Geteuid()) {
+			conn.Close()
+			return nil, fmt.Errorf("untrusted private Ask peer")
+		}
+		return conn, nil
+	}}
+	return &http.Client{Transport: transport, Timeout: 5 * time.Minute}, true
+}
+
+func privateAskRecent(client *http.Client, port int) error {
+	resp, err := client.Get(fmt.Sprintf("http://127.0.0.1:%d/api/ask/recent", port))
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("private Ask service unavailable")
+	}
+	var records []askRecord
+	if err := json.NewDecoder(io.LimitReader(resp.Body, 4<<20)).Decode(&records); err != nil {
+		return err
+	}
+	for i := range records {
+		records[i].Images = extractImages(records[i].Answer)
+		records[i].Actions = extractActions(records[i].Answer)
+	}
+	return json.NewEncoder(os.Stdout).Encode(records)
 }
 
 // askGet prints a daemon GET response verbatim (JSON for --recent).
